{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:start": ".\\\\.local_postgres\\\\pgsql\\\\bin\\\\pg_ctl.exe start -D .\\\\.local_postgres\\\\data -l .\\\\.local_postgres\\\\postgres.log || exit 0",
    "db:stop": ".\\\\.local_postgres\\\\pgsql\\\\bin\\\\pg_ctl.exe stop -D .\\\\.local_postgres\\\\data || exit 0",
    "predev": "npm run db:start",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dry": "tsx scripts/migrate.ts --dry-run",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "test:demo-seed": "tsx -r dotenv/config tests/demo-seed-integrity.test.ts",
    "test:real-db": "tsx tests/real-postgres-integration.test.ts",
    "test:lease-concurrency": "tsx tests/lease-concurrency-postgres.test.ts",
    "test:owner": "tsx -r dotenv/config tests/owner-domain-idor-adversary.test.ts",
    "test:company": "tsx -r dotenv/config tests/company-domain-adversary.test.ts",
    "test:tenant": "tsx -r dotenv/config tests/tenant-domain-adversary.test.ts",
    "test:buyer": "tsx -r dotenv/config tests/buyer-domain-adversary.test.ts",
    "test:agent": "tsx -r dotenv/config tests/agent-domain-adversary.test.ts",
    "test:vendor": "tsx -r dotenv/config tests/vendor-domain-adversary.test.ts",
    "test:finance": "tsx -r dotenv/config tests/finance-domain-adversary.test.ts",
    "test:analytics": "tsx -r dotenv/config tests/analytics-domain-adversary.test.ts",
    "test:autopilot": "tsx -r dotenv/config tests/autopilot-removal-verification.test.ts",
    "test:trust": "tsx -r dotenv/config tests/trust-domain-adversary.test.ts",
    "test:communications": "tsx -r dotenv/config tests/communications-crm-adversary.test.ts",
    "test:stage12": "tsx -r dotenv/config tests/stage12-infrastructure-smoke.test.ts",
    "test:admin": "tsx -r dotenv/config tests/admin-authorization-matrix.test.ts",
    "test:forensic": "tsx -r dotenv/config tests/forensic-remediation-master-verification.test.ts",
    "test:auth-guard": "tsx tests/auth-invariants-permanent-guard.test.ts",
    "test:role-selection": "tsx tests/role-selection-enforcement.test.tsx",
    "test:e2e": "playwright test",
    "screenshot": "tsx scripts/capture-screenshot.ts",
    "test": "npm run test:owner && npm run test:company && npm run test:tenant && npm run test:buyer && npm run test:agent && npm run test:vendor && npm run test:finance && npm run test:analytics && npm run test:autopilot && npm run test:trust && npm run test:communications && npm run test:stage12"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "pg-mem": "^3.0.14",
    "playwright": "^1.63.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
