+        managementFeeRate: (operatingModel === 'FULLY_MANAGED' || operatingModel === 'AGENT_LISTED_PLATFORM_MANAGED') ? managementFeeRate : null,
+        scheduledRentAmount: 0,
+        confirmedCollectedRent: 0,
+        platformFeeAmount: 0,
+        rentFeeAmount: 0,
+        managementFeeAmount: 0,
